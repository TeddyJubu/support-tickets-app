# Support Tickets App - Environment Variables
# Copy this file to .env.local and fill in your Cloudflare credentials

# Cloudflare account ID (dashboard → Workers & Pages → Account details)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# API token with the "Workers AI: Read" permission
# (dashboard → My Profile → API Tokens → Create Token → "Workers AI" template)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# This install's store (lib/settings.ts): UI name, AI prompts, support address, email sender.
# Set these for every new store; the defaults are the demo install's (Cute Things,
# support@teddyonfriday.com). SENDER_NAME defaults to "<STORE_NAME> Support",
# OUTBOUND_EMAIL_FROM to "<SENDER_NAME> <SUPPORT_EMAIL>".
# STORE_NAME=Cute Things
# STORE_DESCRIPTION=a small online baby and children's store
# SUPPORT_EMAIL=support@example.com
# SENDER_NAME=
# OUTBOUND_EMAIL_FROM=

# Shopify store (read-only order lookups for the customer rail, copilot and AI drafts).
# Create an app in the Shopify Dev Dashboard with Admin API scopes read_customers and
# read_orders (add read_all_orders for orders older than 60 days), request protected
# customer data access for name and email, and install it on the store. The helpdesk
# gets a token with the app's client credentials and renews it. Or set SHOPIFY_ADMIN_TOKEN
# to a fixed Admin API token instead of the client ID/secret.
# SHOPIFY_SHOP=cute-things
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-10

# Web sign-in uses staff accounts stored in data/sim.db, not env vars:
#   npm run helpdesk -- user add <username> --name "Full Name" --owner

# Optional: any Workers AI model with function calling
# (e.g. @cf/zai-org/glm-5.3-flash, @cf/zai-org/glm-4.7-flash, @cf/moonshotai/kimi-k2.6,
#  @cf/openai/gpt-oss-120b, @cf/meta/llama-4-scout-17b-16e-instruct)
# CF_MODEL=@cf/zai-org/glm-5.3-flash

# Off-site backups: the worker's encrypted backups are uploaded to this S3-compatible bucket
# (Cloudflare R2 or AWS S3; a token for this bucket only). Without these they stay in
# data/backups/ on this machine, and `npm run helpdesk -- ops` reports offsiteBackups failing.
# BACKUP_S3_URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
