# Background worker: AI drafts, scheduled maintenance, alerts, monitor, backups.
# Install (needs the owner's OK):
#   sudo cp deploy/systemd/support-tickets-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now support-tickets-worker
[Unit]
Description=Support Tickets worker (AI drafts and scheduled tasks)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/support-tickets-app
Environment=NODE_ENV=production
Environment=PATH=/home/ubuntu/.local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/node --no-warnings --import ./scripts/register-ts.mjs scripts/worker.ts
Restart=always
RestartSec=5
# SIGTERM lets the current draft finish (up to 270 s)
KillSignal=SIGTERM
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
